<?xml version="1.0"?>
<sdf version="1.7">
  <model name="plate">
    <link name="plate_base_link">
    </link>
    <link name="plate_body">
      <visual name="plate_visual">
        <pose> 0 0 0.035 0 0 0</pose>
        <geometry>
          <cylinder radius="0.2" length="0.07"/>
        </geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="plate">
        <pose> 0 0 0.035 0 0 0</pose>
        <geometry>
          <cylinder radius="0.2" length="0.07"/>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>1e7</drake:hydroelastic_modulus>
          <drake:mu_dynamic>0.5</drake:mu_dynamic>
          <drake:hunt_crossley_dissipation>1.25</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>
    </link>
    <joint name="joint" type="continuous">
      <child>plate_body</child>
      <parent>plate_base_link</parent>
      <axis xyz="0 0 1"/>
      <origin xyz="0 0 0"/>
    </joint>
  </model>
</sdf>
